{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "packages/cli/bin/aurict",
        "packages/cli/src/index.ts",
        "packages/core/src/index.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "packages/*/src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": ["@types/bun"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/index.ts", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "dist/**",
    "packages/*/dist/**",
    "mobile/**",
    "apps/backend/**",
    "private-docs/**",
    "evals/**"
  ],
  "ignoreBinaries": ["docker", "rg", "bun"]
}